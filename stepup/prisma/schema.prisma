generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Users ───────────────────────────────────────────────────────────────────
//
// ROLE: "STUDENT" | "STUDIO_OWNER" | "INSTRUCTOR" | "ADMIN"
//
// STUDENT      - takes classes, in person or online
// STUDIO_OWNER - runs a physical studio, hosts in-person (or streamed) classes
// INSTRUCTOR   - teacher: independent (hosts their own online or in-person
//                classes) and/or on a studio team via StudioMember
// ADMIN        - platform staff; moderation and support tooling
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  // Null for an account that has never had a password set: a guest who
  // booked without signing up, or a Google-only sign-in. Both claim the
  // account by setting one through the password-reset flow.
  passwordHash String?
  name         String
  role         String
  // Public-facing name shown to dancers when it differs from the account
  // holder's own name — e.g. an independent instructor trading as
  // "Maya R. Dance". Falls back to `name` when unset.
  displayName  String?
  bio          String?
  homeCity     String?
  // IANA zone (e.g. "Australia/Sydney"). Used to render times for this user.
  timezone     String  @default("Australia/Sydney")
  avatarEmoji  String  @default("🕺")
  avatarColor  String  @default("#FC5200")
  // Independent instructors use a line-art mark on a coloured disc instead
  // of initials or an emoji. Null for everyone else, who keep initials.
  avatarMark   String?

  // Leaderboards are opt-in, not opt-out: a dancer is only ever listed once
  // they have chosen to appear. Defaulting this to true would make the
  // board's own footer ("only include dancers who chose to appear") a lie.
  // The toggle lives on /profile#visibility.
  leaderboardOptIn Boolean @default(false)

  emailVerifiedAt DateTime?
  // Set when an admin suspends the account; suspended users cannot sign in.
  suspendedAt     DateTime?
  suspendedReason String?

  acceptedTermsAt DateTime?

  // Mobile number, as entered at sign-up by studio staff and teachers. Not
  // verified: nothing sends texts yet, so nothing claims to.
  phone String?

  // A teacher's public profile, shown on the classes they teach. The note is
  // the quote on every class page ("Nobody's watching your feet but you").
  teachStyles   String[] @default([])
  yearsTeaching String?
  teacherNote   String?
  photoId       String?  @unique
  photo         Image?   @relation("UserPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studio        Studio?              @relation("StudioOwner")
  memberships   StudioMember[]       @relation("MemberUser")
  invitesSent   StudioMember[]       @relation("MemberInvitedBy")
  wwccVerified  StudioMember[]       @relation("WwccVerifiedBy")
  termsAccepted TermsAcceptance[]
  credits       StudioCredit[]
  enrolments    Enrolment[]
  studioOptOuts StudioOptOut[]
  passOffersGot PassOfferRecipient[]
  messagesSent  ClassMessage[]
  textCommands  TextCommand[]
  venues        Venue[]
  hostedClasses DanceClass[]         @relation("ClassHost")
  hostedSeries  ClassSeries[]        @relation("SeriesHost")
  bookings      Booking[]
  profile       GamificationProfile?
  badges        UserBadge[]
  payoutAccount PayoutAccount?
  tokens        AuthToken[]
  auditEntries  AuditLog[]           @relation("AuditActor")

  @@index([role])
  @@index([suspendedAt])
  @@index([leaderboardOptIn])
}

// Email verification + password reset tokens. Only a hash of the token is
// stored, so a database leak doesn't hand out working reset links.
//
// PURPOSE: "EMAIL_VERIFICATION" | "PASSWORD_RESET"
model AuthToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  purpose   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@index([expiresAt])
}

// Rolling record of sign-in attempts, used to lock out brute-force attackers.
// Keyed by email (not user) so attempts against unknown accounts still count.
model LoginAttempt {
  id          String   @id @default(cuid())
  email       String
  ipHash      String?
  successful  Boolean  @default(false)
  attemptedAt DateTime @default(now())

  @@index([email, attemptedAt])
  @@index([attemptedAt])
}

// ─── Studios & payouts ───────────────────────────────────────────────────────

model Studio {
  id          String @id @default(cuid())
  name        String
  description String
  city        String
  address     String
  // IANA zone the studio's local class times are expressed in.
  timezone    String @default("Australia/Sydney")
  emoji       String @default("🏢")

  // Australian Business Number, 11 digits, checked against the ABN checksum
  // at sign-up. Null for studios that joined before it was asked for.
  abn     String?
  // The Sydney suburb from the shared list, which is what beginners are
  // matched on. Older studios fall back to reading it off the address.
  suburb  String?
  // "How to find the door", shown to people once they have booked.
  arrive  String?
  styles  String[] @default([])
  photoId String?  @unique
  photo   Image?   @relation("StudioPhoto", fields: [photoId], references: [id], onDelete: SetNull)

  // Late cancellation preset every class uses unless it overrides it.
  // CANCEL POLICY: "RELAXED" | "STANDARD" | "STRICT"
  cancelPolicy  String  @default("STANDARD")
  // The weekday Stripe pays the studio out on. "MON" … "FRI".
  payoutDay     String  @default("THU")
  kidsClasses   Boolean @default(false)
  // StepUp collects no health information; a studio that needs it links its
  // own form, which students are sent to.
  healthFormUrl String?

  // Concierge onboarding: StepUp drafts the profile (bio, styles, photos)
  // from the studio's website and Instagram, and the studio approves it.
  draftBio          String?
  draftStyles       String[]  @default([])
  draftPreparedAt   DateTime?
  profileApprovedAt DateTime?

  // Pass offer sent automatically the day after a student's first class.
  passOfferAuto    Boolean @default(false)
  passOfferPassId  String?
  passOfferMessage String?

  suspendedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // The account that signed the studio up. It hosts every studio class, so
  // payments for them go to its payout account.
  ownerId String @unique
  owner   User   @relation("StudioOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  classes        DanceClass[]
  series         ClassSeries[]
  members        StudioMember[]
  photos         StudioPhoto[]
  venues         Venue[]
  levelNames     LevelName[]
  templates      ClassTemplate[]
  terms          StudioTerms[]
  termsAccepted  TermsAcceptance[]
  passes         StudioPass[]
  passOffers     PassOffer[]
  optOuts        StudioOptOut[]
  credits        StudioCredit[]
  courseInterest CourseInterest[]

  @@index([city])
}

// A person on a studio's team: the account holder, a manager, or a teacher.
// Invited people exist here before they have an account, so `userId` is null
// until they join with their invite code.
//
// ROLE:   "OWNER" | "MANAGER" | "TEACHER"
// STATUS: "INVITED" | "ACTIVE"
model StudioMember {
  id      String  @id @default(cuid())
  name    String
  // Email or Australian mobile, exactly as the studio entered it.
  contact String
  role    String
  status  String  @default("INVITED")
  // Whether this person can be picked as a class's teacher. Always true for
  // teachers; the owner turns it on with "I teach classes here too".
  teaches Boolean @default(true)

  // Working With Children Check, needed to teach a kids' class. NSW has no
  // public API for it: the studio checks the number on the Office of the
  // Children's Guardian site and records here that it did, and when.
  wwccNumber       String?
  wwccExpiry       DateTime?
  wwccVerifiedAt   DateTime?
  wwccVerifiedById String?
  wwccVerifiedBy   User?     @relation("WwccVerifiedBy", fields: [wwccVerifiedById], references: [id], onDelete: SetNull)
  wwccReminderAt   DateTime?

  // Random, single use and expiring. Cleared once someone joins with it, so a
  // code that leaks after use opens nothing.
  inviteCode      String?   @unique
  inviteExpiresAt DateTime?
  joinedAt        DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation("MemberUser", fields: [userId], references: [id], onDelete: SetNull)

  invitedById String?
  invitedBy   User?   @relation("MemberInvitedBy", fields: [invitedById], references: [id], onDelete: SetNull)

  classes DanceClass[]  @relation("ClassTeacher")
  series  ClassSeries[] @relation("SeriesTeacher")

  @@unique([studioId, userId])
  @@index([studioId, status])
  @@index([userId])
}

// An uploaded photo, stored in the database so it needs no extra storage
// service. Images are re-encoded to a modest JPEG in the browser before
// upload and checked again on the server, so rows stay small.
model Image {
  id          String   @id @default(cuid())
  contentType String
  bytes       Bytes
  createdAt   DateTime @default(now())

  studio      Studio?      @relation("StudioPhoto")
  user        User?        @relation("UserPhoto")
  studioPhoto StudioPhoto?
}

// An uploaded PDF (a studio's own terms), checked to really be a PDF.
model Document {
  id          String   @id @default(cuid())
  filename    String
  contentType String
  bytes       Bytes
  createdAt   DateTime @default(now())

  terms StudioTerms[]
}

// A studio's gallery. `draft` photos belong to the concierge draft and go
// live when the studio approves it.
model StudioPhoto {
  id        String   @id @default(cuid())
  sort      Int      @default(0)
  draft     Boolean  @default(false)
  createdAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  imageId  String @unique
  image    Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([studioId, sort])
}

// A saved place to hold a class: a hall a studio hires, or an independent
// teacher's usual spots. A studio's own address is always available and
// isn't stored here.
model Venue {
  id        String   @id @default(cuid())
  name      String
  address   String
  suburb    String?
  createdAt DateTime @default(now())

  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId   String?
  user     User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classes DanceClass[]
  series  ClassSeries[]

  @@index([studioId])
  @@index([userId])
}

// A studio's own level name, mapped once onto StepUp's shared scale.
// SCALE: "ABSOLUTE_BEGINNER" | "BEGINNER" | "IMPROVER" | "INTERMEDIATE" | "ADVANCED"
model LevelName {
  id        String   @id @default(cuid())
  name      String
  scale     String
  createdAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@index([studioId])
}

// A studio's own wording for a style at a level, so a new class never starts
// blank. Missing ones fall back to StepUp's starting template.
model ClassTemplate {
  id          String   @id @default(cuid())
  style       String
  scale       String
  description String
  wear        String
  plan        String
  updatedAt   DateTime @updatedAt

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, style, scale])
}

// One published version of a studio's terms. Students accept each version
// once; publishing a new one asks them again at their next booking.
// MODE: "TEMPLATE" | "UPLOAD"
model StudioTerms {
  id           String   @id @default(cuid())
  version      Int
  mode         String
  waiver       Boolean  @default(true)
  conduct      Boolean  @default(true)
  cancellation Boolean  @default(true)
  publishedAt  DateTime @default(now())

  studioId   String
  studio     Studio    @relation(fields: [studioId], references: [id], onDelete: Cascade)
  documentId String?
  document   Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)

  acceptances TermsAcceptance[]

  @@unique([studioId, version])
}

model TermsAcceptance {
  id         String   @id @default(cuid())
  version    Int
  acceptedAt DateTime @default(now())

  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  studioId String
  studio   Studio      @relation(fields: [studioId], references: [id], onDelete: Cascade)
  termsId  String
  terms    StudioTerms @relation(fields: [termsId], references: [id], onDelete: Cascade)

  @@unique([userId, termsId])
  @@index([userId, studioId])
}

// One of the studio's own passes or memberships. StepUp doesn't sell these:
// a pass offer points students at the studio, and there's no commission.
model StudioPass {
  id         String    @id @default(cuid())
  name       String
  priceCents Int
  link       String?
  archivedAt DateTime?
  createdAt  DateTime  @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  offers PassOffer[]
}

// AUDIENCE: "FIRST" (after their first class) | "ALL" | "AUTO" (sent the day
// after one student's first class)
model PassOffer {
  id         String   @id @default(cuid())
  message    String
  audience   String
  recipients Int      @default(0)
  createdAt  DateTime @default(now())

  studioId String
  studio   Studio     @relation(fields: [studioId], references: [id], onDelete: Cascade)
  passId   String
  pass     StudioPass @relation(fields: [passId], references: [id], onDelete: Cascade)

  sentTo PassOfferRecipient[]
}

model PassOfferRecipient {
  id     String   @id @default(cuid())
  sentAt DateTime @default(now())

  offerId String
  offer   PassOffer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId  String
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([offerId, userId])
  @@index([userId])
}

// A student who has asked a studio to stop marketing to them.
model StudioOptOut {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([studioId, userId])
}

// Credit from a late cancellation under the Standard policy. It's held with
// the class's host (a studio's account hosts all its classes, so this is
// credit at that studio) and pays for a later class there that costs no more
// than it's worth.
model StudioCredit {
  id          String    @id @default(cuid())
  amountCents Int
  currency    String    @default("aud")
  reason      String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  hostId   String
  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: SetNull)

  fromBookingId   String? @unique
  usedByBookingId String? @unique

  @@index([userId, hostId])
}

// A whole course bought in one go: one booking per session, one payment.
// STATUS: "PENDING_PAYMENT" | "ENROLLED" | "CANCELLED"
model Enrolment {
  id          String    @id @default(cuid())
  status      String    @default("PENDING_PAYMENT")
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?

  userId   String
  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  seriesId String
  series   ClassSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  bookings Booking[]

  @@unique([userId, seriesId])
}

// "Tell me when it opens" on a course that has already started.
model CourseInterest {
  id         String    @id @default(cuid())
  style      String
  email      String
  notifiedAt DateTime?
  createdAt  DateTime  @default(now())

  studioId String
  studio   Studio @relation(fields: [studioId], references: [id], onDelete: Cascade)

  @@unique([studioId, style, email])
}

// "Message class": everything sent to a class, kept so managers can see it.
model ClassMessage {
  id         String   @id @default(cuid())
  body       String
  recipients Int
  channels   String
  createdAt  DateTime @default(now())

  classId  String
  class    DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  senderId String?
  sender   User?      @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([classId, createdAt])
}

// Someone added at the door, so the head count stays right. Not a StepUp
// booking: no account, no payment, no commission.
model WalkIn {
  id        String   @id @default(cuid())
  name      String
  role      String?
  createdAt DateTime @default(now())

  classId String
  class   DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([classId])
}

// A teacher's text ("cancel thu salsa") waiting for them to reply YES.
// KIND: "CANCEL" | "MESSAGE" | "MOVE"   STATUS: "PENDING" | "DONE" | "EXPIRED"
model TextCommand {
  id        String   @id @default(cuid())
  kind      String
  payload   String
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())

  userId  String
  user    User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  classId String
  class   DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

// Stripe Connect (Express) account for a host, so class fees are paid out to
// them directly and the platform collects an application fee.
//
// STATUS: "PENDING" | "ONBOARDING" | "ACTIVE" | "RESTRICTED"
model PayoutAccount {
  id               String  @id @default(cuid())
  stripeAccountId  String  @unique
  status           String  @default("PENDING")
  chargesEnabled   Boolean @default(false)
  payoutsEnabled   Boolean @default(false)
  detailsSubmitted Boolean @default(false)
  country          String  @default("AU")
  defaultCurrency  String  @default("aud")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Classes ─────────────────────────────────────────────────────────────────

// A repeating weekly timetable entry. Individual DanceClass rows (sessions)
// are generated from it on a rolling horizon.
//
// FREQUENCY: "WEEKLY"
model ClassSeries {
  id          String  @id @default(cuid())
  title       String
  style       String
  description String
  format      String
  level       String  @default("ALL_LEVELS")
  location    String?
  onlineLink  String?

  // 0 = Sunday … 6 = Saturday, in the owning studio/host's timezone.
  dayOfWeek Int
  // Local wall-clock start, "HH:mm" in the owning timezone. Stored as text so
  // it survives daylight-saving shifts (7pm stays 7pm year round).
  localTime String
  timezone  String @default("Australia/Sydney")
  // "WEEKLY" | "FORTNIGHTLY"
  frequency String @default("WEEKLY")

  durationMin Int    @default(60)
  capacity    Int    @default(20)
  points      Int    @default(20)
  priceCents  Int    @default(0)
  currency    String @default("aud")

  // How the class is listed. LISTING: "DROP_IN" | "TRIAL" | "COURSE" | "HIDDEN"
  listing          String  @default("DROP_IN")
  stepupSpots      Int?
  courseWeeks      Int?
  coursePriceCents Int?
  partnerRule      String?
  leadCap          Int?
  followCap        Int?
  balanceX         Int?
  cancelPolicy     String?
  kids             Boolean @default(false)
  venueId          String?
  venue            Venue?  @relation(fields: [venueId], references: [id], onDelete: SetNull)

  enrolments Enrolment[]

  // First Timer class details, copied onto every generated session.
  music           String?
  partner         String?
  firstTimerSpots Int?
  wear            String?
  plan            String?
  room            String?
  suburb          String?
  arrive          String?

  startsOn DateTime
  endsOn   DateTime?

  archivedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostId String
  host   User   @relation("SeriesHost", fields: [hostId], references: [id], onDelete: Cascade)

  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  teacherMemberId String?
  teacherMember   StudioMember? @relation("SeriesTeacher", fields: [teacherMemberId], references: [id], onDelete: SetNull)

  sessions DanceClass[]

  @@index([hostId])
  @@index([archivedAt])
}

// A single dated class session.
//
// FORMAT: "IN_PERSON" | "ONLINE"
// LEVEL:  "ALL_LEVELS" | "BEGINNER" | "INTERMEDIATE" | "ADVANCED"
model DanceClass {
  id          String  @id @default(cuid())
  title       String
  style       String
  description String
  format      String
  level       String  @default("ALL_LEVELS")
  location    String?
  onlineLink  String?

  // Absolute instant, always stored in UTC.
  startTime DateTime
  // IANA zone the class actually happens in — needed to display and reason
  // about its local wall-clock time (e.g. "is this an early-morning class?").
  timezone  String   @default("Australia/Sydney")

  durationMin Int @default(60)
  capacity    Int @default(20)
  points      Int @default(20)

  priceCents Int    @default(0)
  currency   String @default("aud")

  // How StepUp lists it.
  // LISTING: "DROP_IN" (a single class) | "TRIAL" (a free first visit, one per
  //   student per studio, no commission) | "COURSE" (booked a whole term at a
  //   time, through its series) | "HIDDEN" (on the studio's timetable only)
  listing     String @default("DROP_IN")
  // How many of the room's places StepUp may sell. The rest stay with the
  // studio's pass holders. Null means all of them.
  stepupSpots Int?

  // Partner work. PARTNER RULE: "CAPS" (separate caps for leads and follows)
  // | "BALANCE" (no more than balanceX extra on either side) | "NONE" (partner
  // work, no role limits). Null: not a partner class.
  partnerRule String?
  leadCap     Int?
  followCap   Int?
  balanceX    Int?

  // Overrides the studio's late cancellation preset for this class.
  cancelPolicy String?
  // A kids' class: booked by a guardian, taught by someone with a verified
  // Working With Children Check.
  kids         Boolean @default(false)

  venueId           String?
  venue             Venue?    @relation(fields: [venueId], references: [id], onDelete: SetNull)
  // When the venue last changed. Anyone booked before then may cancel free.
  venueChangedAt    DateTime?
  // When the teacher was sent the class list, 48 hours before.
  teacherListSentAt DateTime?

  messages     ClassMessage[]
  walkIns      WalkIn[]
  textCommands TextCommand[]

  // First Timer class details. All optional: classes listed before these
  // fields existed simply don't have them, and the pages say less.
  //
  // MUSIC:   "latin" | "hiphop" | "classical" | "afro" | "any" (the matcher's ids)
  // PARTNER: "SOLO" | "ROTATE" | "BRING"
  music           String?
  partner         String?
  // Spots kept for people on their first class, at most `capacity`.
  firstTimerSpots Int?
  wear            String?
  plan            String?
  room            String?
  // An independent instructor's in-person venue. Studio classes use the
  // studio's suburb and door directions instead.
  suburb          String?
  arrive          String?

  // Who teaches it, for a studio class. An independent instructor's class is
  // taught by its host, so this stays null. A class belongs to a studio
  // (studioId set, hosted by the studio's account) or to an independent
  // instructor (studioId null), never both.
  teacherMemberId String?
  teacherMember   StudioMember? @relation("ClassTeacher", fields: [teacherMemberId], references: [id], onDelete: SetNull)

  // Short rotating code the host reveals during class; students enter it to
  // claim attendance. Null until the host starts check-in.
  checkInCode      String?
  checkInCodeSetAt DateTime?

  cancelledAt     DateTime?
  cancelledReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hostId String
  host   User   @relation("ClassHost", fields: [hostId], references: [id], onDelete: Cascade)

  studioId String?
  studio   Studio? @relation(fields: [studioId], references: [id], onDelete: Cascade)

  seriesId String?
  series   ClassSeries? @relation(fields: [seriesId], references: [id], onDelete: SetNull)

  bookings Booking[]

  // One generated session per series per start time.
  @@unique([seriesId, startTime])
  @@index([startTime])
  @@index([hostId])
  @@index([studioId])
  @@index([style])
  @@index([cancelledAt, startTime])
  @@index([teacherMemberId])
}

// ─── Bookings & payments ─────────────────────────────────────────────────────

// STATUS: "PENDING_PAYMENT" | "BOOKED" | "ATTENDED" | "NO_SHOW" | "CANCELLED" | "WAITLISTED"
model Booking {
  id             String    @id @default(cuid())
  status         String    @default("BOOKED")
  // Partner classes: ROLE "LEAD" | "FOLLOW" | "EITHER". Waitlists are per role.
  role           String?
  // Anything the student wants their teacher to know.
  note           String?
  noShowAt       DateTime?
  // Set when this no-show triggered a warning or the prepay rule, so
  // toggling it on the class list never sends the same notice twice.
  noShowNoticeAt DateTime?

  enrolmentId String?
  enrolment   Enrolment? @relation(fields: [enrolmentId], references: [id], onDelete: SetNull)
  bookedAt    DateTime   @default(now())
  attendedAt  DateTime?
  cancelledAt DateTime?

  // Position in the waitlist queue; null for confirmed bookings.
  waitlistPosition Int?

  // When each pre-class reminder actually went out. These are the idempotency
  // record: the cron job only picks up bookings whose stamp is still null, so
  // a retry, an overlapping run or a redeploy cannot send the same reminder
  // twice.
  remindedDayBeforeAt DateTime?
  remindedDayOfAt     DateTime?

  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  classId String
  class   DanceClass @relation(fields: [classId], references: [id], onDelete: Cascade)

  payment Payment?

  @@unique([userId, classId])
  @@index([enrolmentId])
  @@index([classId, status])
  @@index([userId, status])
  @@index([status, attendedAt])
}

// STATUS: "PENDING" | "PAID" | "FAILED" | "REFUNDED"
// SALE TYPE: "AGENT" (the studio's own listing: StepUp is its booking agent,
// class GST stays with the studio) | "SELLER" (StepUp's own packs or credits:
// StepUp sells, charges GST on the full price, pays the studio an agreed
// amount). Every payment so far is AGENT; StepUp sells nothing itself yet.
model Payment {
  id          String @id @default(cuid())
  status      String @default("PENDING")
  saleType    String @default("AGENT")
  amountCents Int
  // Platform's cut, in the same currency.
  feeCents    Int    @default(0)
  currency    String @default("aud")

  stripeCheckoutSessionId String? @unique
  stripePaymentIntentId   String? @unique
  stripeRefundId          String?

  paidAt        DateTime?
  refundedAt    DateTime?
  failureReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([status])
}

// Stripe webhook deduplication — Stripe may deliver the same event more than
// once, and payment side effects must only run a single time.
model ProcessedWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

// ─── Gamification ────────────────────────────────────────────────────────────

model GamificationProfile {
  id             String    @id @default(cuid())
  totalPoints    Int       @default(0)
  currentStreak  Int       @default(0)
  longestStreak  Int       @default(0)
  classesTaken   Int       @default(0)
  lastAttendedAt DateTime?

  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([totalPoints])
}

model Badge {
  id          String @id @default(cuid())
  code        String @unique
  name        String
  description String
  emoji       String
  sortOrder   Int    @default(0)

  awards UserBadge[]
}

model UserBadge {
  id       String   @id @default(cuid())
  earnedAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  badgeId String
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
}

// ─── Moderation ──────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  targetType String
  targetId   String
  detail     String?
  createdAt  DateTime @default(now())

  actorId String
  actor   User   @relation("AuditActor", fields: [actorId], references: [id], onDelete: Cascade)

  @@index([targetType, targetId])
  @@index([createdAt])
}
